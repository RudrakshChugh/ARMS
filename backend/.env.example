PORT=5000

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/semester_portal

JWT_SECRET=YOUR_JWT_SECRET

# Origin of the deployed frontend. Used for OAuth redirects and added to the CORS allowlist.
FRONTEND_URL=http://localhost:5173

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# local | supabase | r2
STORAGE_PROVIDER=local

# Required when STORAGE_PROVIDER=supabase
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=YOUR_BUCKET_NAME

# Required when STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ENDPOINT=
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=YOUR_R2_BUCKET_NAME
